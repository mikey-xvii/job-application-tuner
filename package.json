{
  "name": "cv-tuner",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Personal CV tuner: paste a job link, get a one-page tailored CV PDF written by Claude.",
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --watch --env-file-if-exists=.env server/index.js",
    "replay": "CV_ENGINE=replay PORT=4322 node --env-file-if-exists=.env server/index.js"
  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "cheerio": "^1.2.0",
    "express": "^5.3.0"
  }
}
