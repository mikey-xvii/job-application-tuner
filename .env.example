# Claude engine. With a key, the app calls the Anthropic API directly.
# Without one, it falls back to your logged-in Claude Code CLI (`claude`).
ANTHROPIC_API_KEY=

# Optional overrides
# CV_ENGINE=api            # force "api" or "cli"
# CV_MODEL=claude-opus-5-5
# CV_EFFORT=high           # low | medium | high | xhigh | max
# CV_MIN_SCALE=0.9         # smallest type scale when squeezing onto one page (0.9 ≈ 8.2pt)
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# PORT=4321
